# FoodKing — Env file dédié à l'ingestion Graphiti.
# Copie en memory/ingest.env (ignoré par git) et adapte si besoin.
#
# Pourquoi ce fichier dédié :
#   - Le ~/.cursor/mcp-graphiti.env de Cursor pointe vers Willow API qui
#     n'expose pas l'endpoint /v1/responses utilisé par Graphiti récent.
#   - OpenRouter supporte /responses ET /chat/completions → on l'utilise
#     pour l'ingestion locale, sans toucher la config Cursor.
#   - L'inférence en Cursor (chat agent) ne change pas — c'est un override
#     PROCESS pour l'ingestion uniquement (via GRAPHITI_ENV_FILE).

# --- Neo4j (réutilise les vraies credentials de l'utilisateur) ---
NEO4J_URI=neo4j+s://dd0ccfed.databases.neo4j.io
NEO4J_USERNAME=dd0ccfed
NEO4J_PASSWORD=REPLACE_ME
NEO4J_DATABASE=dd0ccfed

# --- LLM provider for entity extraction (OpenRouter, supports /responses) ---
OPENAI_API_KEY=sk-or-v1-REPLACE_ME
OPENAI_API_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Modèle léger et rapide pour extraction d'entités sur 180 épisodes.
# Choix : openai/gpt-4o-mini (rapide, économique) ; alternative : anthropic/claude-haiku-4.5
GRAPHITI_LLM_MODEL=openai/gpt-4o-mini

# --- Embedder (LiteLLM local pour rester rapide / gratuit) ---
OPENAI_EMBEDDING_API_URL=http://127.0.0.1:4000/v1
OPENAI_EMBEDDING_API_KEY=litellm-proxy

# --- Group ID Graphiti pour ce projet ---
GRAPHITI_GROUP_ID=foodking

# --- LiteLLM (toujours nécessaire pour les embeddings) ---
MOONSHOT_API_KEY=REPLACE_ME
MOONSHOT_API_BASE=https://api.moonshot.ai/v1
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
