# =============================================================================
# FoodKing SaaS — Environment Configuration Example
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# CRITICAL: Some settings below are MANDATORY for production.
#
# Local development: can use defaults (file cache, sync queue)
# Production (multi-worker PHP-FPM, real-time KDS): MUST use Redis.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=FoodKing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
KIOSK_DOMAIN=
ADMIN_DOMAIN=
# Staff-only V1 shell + wizard borne (tests StaffOnlyRoutingTest / Echo)
STAFF_ONLY_MODE=false
KIOSK_USE_POS_WIZARD=false

# Pricing SSOT: delegate cart math to App\Services\Pricing\PricingService (OrderService / FrontendOrderService).
# Set false to use legacy inline calculations (rollback).
PRICING_USE_SSOT=true

# [CRITICAL] Toutes les requêtes /api/* exigent le header x-api-key (SPA admin, borne, etc.).
# Valeur lue par Laravel : config('app.api_key') = MIX_API_KEY, avec repli sur API_KEY si MIX vide.
MIX_API_KEY=change-me-long-random-string-local-dev
# API_KEY=legacy-only-if-MIX_API_KEY-empty

# -----------------------------------------------------------------------------
# Borne (kiosk Windows) — démarrage DIRECT sans écran login (défaut)
# -----------------------------------------------------------------------------
# Connexion machine silencieuse (aucun mot de passe à l'écran) — aligné sur KioskMachineTableSeeder.
# En APP_ENV=local, si ces lignes sont absentes, config/kiosk.php retombe sur kiosk-lecayenne / kiosk123.
# Production : obligatoire + mot de passe unique par borne (php artisan foodking:ensure-kiosk-machine).
KIOSK_MACHINE_USERNAME=kiosk-lecayenne
KIOSK_MACHINE_PASSWORD=kiosk123
# Pour réafficher un formulaire login (audit) : KIOSK_REQUIRE_MACHINE_LOGIN=true

# -----------------------------------------------------------------------------
# Database — MySQL 8+
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodking
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Cache — REDIS MANDATORY in production
# -----------------------------------------------------------------------------
# [CRITICAL-PROD] CACHE_DRIVER=file is NOT atomic across PHP-FPM workers.
# In production with multiple workers, you MUST use redis or database
# for Cache::lock() to work correctly (queue number allocation).
CACHE_DRIVER=file
# CACHE_DRIVER=redis  # [PRODUCTION] Uncomment this line in production

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# -----------------------------------------------------------------------------
# Queue — REDIS/DATABASE MANDATORY in production
# -----------------------------------------------------------------------------
# [CRITICAL-PROD] QUEUE_CONNECTION=sync is synchronous and blocks the API.
# For real-time KDS/OSS updates via broadcasting, you MUST use a queue worker.
QUEUE_CONNECTION=sync
# QUEUE_CONNECTION=redis  # [PRODUCTION] Uncomment this line in production
# QUEUE_CONNECTION=database  # Alternative if Redis unavailable

# [PRODUCTION] Start a queue worker:
# php artisan queue:work --queue=high,default
# Or use supervisord to keep it running (see documentation).

# -----------------------------------------------------------------------------
# Broadcasting — Real-time KDS/OSS
# -----------------------------------------------------------------------------
# For real-time order updates to Kitchen Display and Order Status Screen.
BROADCAST_DRIVER=pusher  # or soketi, ably, redis

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# Soketi (self-hosted alternative to Pusher) — recommended for on-premise
# BROADCAST_DRIVER=pusher
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_APP_KEY=your-soketi-key
# PUSHER_APP_SECRET=your-soketi-secret
# PUSHER_APP_ID=your-soketi-id
# PUSHER_SCHEME=http
# PUSHER_APP_CLUSTER=mt1

# -----------------------------------------------------------------------------
# Session & Broadcasting Frontend
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,yourdomain.com

# -----------------------------------------------------------------------------
# Mail — For customer order confirmations
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@foodking.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS S3 — For product images (optional, defaults to local storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# TPE / Payment Terminal (Electron IPC for Windows kiosk)
# -----------------------------------------------------------------------------
# These are read by the kiosk Electron app, not Laravel directly.
# KIOSK_TPE_ENABLED=true
# KIOSK_TPE_DEVICE_PATH=COM3  # Windows serial port or IP:PORT
# KIOSK_TPE_MERCHANT_ID=your-merchant-id
# KIOSK_TPE_TERMINAL_ID=your-terminal-id

# V1 launch: external SumUp terminal at counter, kiosk has no TPE wired.
# When true, the kiosk skips its payment-method grid and submits an unpaid
# order with a queue number; customer pays at caisse.
KIOSK_PAY_AT_COUNTER_ONLY=true

# -----------------------------------------------------------------------------
# Loyalty Program Settings
# -----------------------------------------------------------------------------
# Configurable via admin panel, but defaults here:
# LOYALTY_POINTS_PER_EURO=10        # 10 points per € spent
# LOYALTY_POINTS_FOR_1_EURO=100     # 100 points = €1 discount

# -----------------------------------------------------------------------------
# Observability — health checks & structured logs
# -----------------------------------------------------------------------------
# Optional: restrict who can call GET /api/health (full report). Empty = no IP filter.
# Liveness/readiness (/api/health/live, /api/health/ready) stay usable for probes.
HEALTH_IPS_ALLOWED=
# Production JSON logs: LOG_CHANNEL=production_json  (see docs/OBSERVABILITY.md)

# -----------------------------------------------------------------------------
# FoodKing SaaS Defaults
# -----------------------------------------------------------------------------
TIMEZONE=Europe/Paris
CASHIER_CURRENCY=EUR
CASHIER_CURRENCY_LOCALE=fr

# -----------------------------------------------------------------------------
# Fiscal secrets (NF525 / Loi Finance 2018 anti-fraude TVA)
# -----------------------------------------------------------------------------
# REQUIRED in production. Must be >= 32 random bytes (e.g. `openssl rand -hex 32`).
# Rotation procedure: docs/FISCAL_SECRETS.md (runbook).
# NEVER reuse the shipping dev defaults in production — AuditLogService and
# ZReportService will refuse to sign if APP_ENV=production and the secret is
# empty, equal to a known dev sentinel, or shorter than 32 chars.
FISCAL_AUDIT_SECRET=
FISCAL_Z_REPORT_SECRET=
# Optional per-branch overrides (example for branch 17):
# FISCAL_AUDIT_SECRET_BRANCH_17=
FISCAL_ARCHIVE_RETENTION_YEARS=6
FISCAL_ARCHIVE_DISK=local
FISCAL_ARCHIVE_PATH=fiscal

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# [ ] Copy .env.example to .env and fill all values
# [ ] Set MIX_API_KEY (non vide) puis : php artisan config:clear
# [ ] Vérifier SPA : dans la console navigateur, window.foodkingConfig.apiKey doit égaler MIX_API_KEY (injecté par master.blade.php)
# [ ] Generate APP_KEY: php artisan key:generate
# [ ] Set APP_ENV=production, APP_DEBUG=false
# [ ] Set CACHE_DRIVER=redis (mandatory for queue lock)
# [ ] Set QUEUE_CONNECTION=redis (mandatory for real-time)
# [ ] Configure Redis connection
# [ ] Start queue worker: php artisan queue:work
# [ ] Configure Soketi/Pusher for broadcasting
# [ ] Run migrations: php artisan migrate
# [ ] Seed initial data: php artisan db:seed (only if not production guard)
# [ ] Configure TPE device (bank parameters)
# [ ] Test kiosk end-to-end: order → KDS → OSS
# =============================================================================
