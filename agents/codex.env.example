# ---------------------------------------------------------------------------
# Équivalent TOML (model_provider OpenAI) → variables lues par codex.runner.mjs
# ---------------------------------------------------------------------------
# TOML / hôte                    | FoodKing
# model_provider = "OpenAI"      | (informatif — le runner n’a pas de nom de provider)
# model = gpt-5.5              | CODEX_MODEL_COMPLEX=gpt-5.5
# review_model = gpt-5.5      | idem (pas de 2e modèle côté runner)
# model_reasoning_effort = xhigh | CODEX_REASONING_EFFORT=xhigh
# [OpenAI] base_url            | CODEX_API_BASE=https://…/v1
# wire_api = responses         | CODEX_WIRE=responses
# requires_openai_auth         | OPENAI_API_KEY ou CODEX_API_KEY
# Ordre chargement             | .env → .env.codex (surcharge) ; le shell lance l’emporte sur les fichiers
# Template racine (copie)     | .env.codex.example → .env.codex
# disable_response_storage, network_access, model_context… | IDE uniquement : .env.codex.example (commentaires)
# TOML miroir                  | agents/codex.provider.openai.example.toml
# Ne jamais committer de vraie clé.
# ---------------------------------------------------------------------------
CODEX_API_BASE=https://subtp7eu3nc8.tokenclub.top/v1
# Authentification (une des deux — même valeur que JSON « OPENAI_API_KEY » côté provider) :
# CODEX_API_KEY=sk-replace-me
# OPENAI_API_KEY=sk-replace-me
CODEX_MODEL_COMPLEX=gpt-5.5
# Fil API : responses (défaut runner) = POST {BASE}/responses  |  chat = /chat/completions + stream
CODEX_WIRE=responses
# xhigh est mappé en « high » dans le JSON reasoning si l’API l’exige
CODEX_REASONING_EFFORT=xhigh
# (Options uniquement côté IDE / autre outil, non lues par codex.runner.mjs :)
# disable_response_storage, network_access, model_context_window=1_000_000, model_auto_compact_token_limit=900_000
# Désactiver l’envoi d’un plafond max_completion (2M) : # CODEX_NO_DEFAULT_OUTPUT_BUDGET=1
# Surcharge : # CODEX_MAX_COMPLETION_TOKENS=…
# Afficher usage stderr : # CODEX_LOG_USAGE=1
# Stream désactivé seulement si 503 stream : # CODEX_DISABLE_STREAM=1
# Long flux (Node 20+) : # CODEX_UNDICI_LONG_STREAM=1, CODEX_UNDICI_BODY_TIMEOUT_MS=0, …
# RETRY_MAX=8
# SLEEP_BASE_MS=2000
