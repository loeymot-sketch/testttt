CODEX_API_BASE=https://subtp7eu3nc8.tokenclub.top/v1
CODEX_API_KEY=
# Modèle: défaut projet = gpt-5.4 (fiable côté proxy). gpt-5.4-pro si ton tableau de bord prouve des réponses complètes.
CODEX_MODEL_COMPLEX=gpt-5.4
# CODEX_MODEL_COMPLEX=gpt-5.4-pro
# Vérification locale (1 requête) : npm run codex:smoke
CODEX_WIRE=chat
# CODEX_AUX_CONTEXT_FILES → liste CSV de fichiers sous missions/<TASK_ID>/ (défaut: graphiti_context, plan, brief…)
# CODEX_APPEND_AUX_WITH_RAW=0 → n’inclut pas le contexte en mode RAW
# CODEX_WIRE=responses   → POST /v1/responses (certaines configs proxy / opencode)
# CODEX_RAW_PROMPT=1     → envoie le contenu brut de input.json, sans agents/codex.prompt.txt
# CODEX_NO_NORMALIZE_M=1 → ne pas renommer la clé JSON `m` → `instruction` (déconseillé : bug proxy)
# CODEX_DISABLE_STREAM=1
# RETRY_MAX=8
# SLEEP_BASE_MS=2000
