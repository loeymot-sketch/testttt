{
  "schema_version": 1,
  "_comment": "Copy to browser_profiles.json and fill real paths/URLs. Never commit secrets.",
  "claude": {
    "enabled": true,
    "start_url": "https://claude.ai/projects/YOUR_PROJECT_ID_HERE",
    "expected_chat_url": "",
    "_expected_chat_url_hint": "If set, must match page.url chat id for URL guard; empty = use start_url. Prefer direct /chat/<uuid> as start_url.",
    "user_data_dir_relative": "bot/browser_runner/profiles/claude-user-data",
    "orchestrator_conversation_label": "00_ORCHESTRATOR",
    "timeouts_ms": {
      "navigation": 60000,
      "after_send": 180000,
      "composer_wait": 30000
    },
    "selectors": {
      "composer_textarea": "textarea",
      "send_button": "button[aria-label*='Send'], button[data-testid='send-button']",
      "assistant_turn": "[data-testid='assistant-message'], .font-claude-message, div[data-is-streaming]"
    },
    "quota_snippets": ["rate limit", "try again later", "upgrade your plan", "usage limit"]
  },
  "cursor": {
    "enabled": true,
    "automation_mode": "clipboard",
    "_automation_mode_values": ["clipboard", "playwright"],
    "start_url": "",
    "user_data_dir_relative": "bot/browser_runner/profiles/cursor-user-data",
    "session_label_hint": "FoodKing Agent tab name (for humans only)"
  }
}
