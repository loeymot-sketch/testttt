# --- Mandatory ---
CODEX_API_BASE=https://your-openai-compatible-proxy.example.com/v1
CODEX_API_KEY=sk-replace-me

# --- Recommended ---
# Default model used by the runner. `gpt-5.4` is more stable on most proxies.
# Override per call with `CODEX_MODEL_COMPLEX=gpt-5.4-pro npm run codex:complex -- <task>`.
CODEX_MODEL_COMPLEX=gpt-5.4

# Wire format: "chat" (default, OpenAI-compatible /chat/completions) or "responses" (/responses).
CODEX_WIRE=chat

# --- Optional ---
# Force one-shot (non-stream) mode. Useful for very small payloads. Most proxies time out
# on long non-stream responses (HTTP 504 Cloudflare) — leave streaming on by default.
# CODEX_DISABLE_STREAM=1

# Send the input.json as-is, without wrapping it in codex.prompt.txt. Use for "raw" missions
# where the task itself defines the output shape (e.g. "give me only the .vue file").
# CODEX_RAW_PROMPT=1

# When CODEX_RAW_PROMPT=1, still append the auxiliary mission context (Graphiti/plan/brief)
# at the end of the user prompt. Defaults to 1 (=on).
# CODEX_APPEND_AUX_WITH_RAW=1

# Comma-separated list of auxiliary context files to look up under missions/<TASK_ID>/
# CODEX_AUX_CONTEXT_FILES=graphiti_context.md,plan_excerpt.md,execute_brief.md,cycle_snapshot.md

# Disable the "m → instruction" key normalization (some OpenAI-compatible proxies filter
# any user JSON whose top-level key is `m` and silently return empty content).
# CODEX_NO_NORMALIZE_M=1

# Retry tuning. Defaults are RETRY_MAX=8, SLEEP_BASE_MS=2000 (exponential backoff).
# RETRY_MAX=8
# SLEEP_BASE_MS=2000
