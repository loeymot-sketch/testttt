# Profil type OpenAI (tokenclub) — copier vers .env.codex (gitignored) : cp .env.codex.example .env.codex
# La surcharge .env.codex a priorité sur .env sauf variables déjà exportées dans le shell.
# Miroir TOML : agents/codex.provider.openai.example.toml

CODEX_API_BASE=https://subtp7eu3nc8.tokenclub.top/v1
# requires_openai_auth
OPENAI_API_KEY=sk-replace-me
# (alternative) # CODEX_API_KEY=sk-replace-me

# model = review_model (une seule clé côté runner)
CODEX_MODEL_COMPLEX=gpt-5.4
# wire_api = responses
CODEX_WIRE=responses
# model_reasoning_effort = xhigh
CODEX_REASONING_EFFORT=xhigh

# Métadonnées utiles pour toi (IDE / rappel, non lues par codex.runner.mjs) :
# IDE_disable_response_storage=true
# IDE_network_access=enabled
# IDE_model_context_window=1000000
# IDE_model_auto_compact_token_limit=900000
# windows_wsl_setup_acknowledged=true
