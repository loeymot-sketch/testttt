# Copier vers .env.anthropic.local (gitignored) — proxy Anthropic (ex. ctok)
# ANTHROPIC_BASE_URL=https://api.ctok.ai
# ANTHROPIC_API_KEY=sk-…
# (alias) # ANTHROPIC_AUTH_TOKEN=…
# CTOK_MAX_OUTPUT=50000
# CTOK_CHAIN_UNTIL_TOTAL=50000
# CTOK_CHAIN_MAX_ROUNDS=24
# CTOK_FETCH_TIMEOUT_MS=900000
# ANTHROPIC_MODEL=claude-opus-4-1-20250514
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# CLAUDE_CODE_ATTRIBUTION_HEADER=0
