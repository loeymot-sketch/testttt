; Remplacer les valeurs FREE_* hors dépôt. Les noms de paramètres exacts sont
; ceux fournis par Free Pro dans la fiche de configuration VoIP/SIP.
[free-pro]
type=registration
outbound_auth=free-pro-auth
server_uri=sip:FREE_REGISTRAR
client_uri=sip:FREE_SIP_USERNAME@FREE_REGISTRAR
contact_user=FREE_SIP_USERNAME
retry_interval=60
forbidden_retry_interval=300
expiration=300

[free-pro-auth]
type=auth
auth_type=userpass
username=FREE_SIP_USERNAME
password=FREE_SIP_PASSWORD

[free-pro-aor]
type=aor
contact=sip:FREE_REGISTRAR

[free-pro-endpoint]
type=endpoint
transport=transport-udp
context=from-free-pro
disallow=all
allow=ulaw,alaw
outbound_auth=free-pro-auth
aors=free-pro-aor
from_user=FREE_SIP_USERNAME

[free-pro-identify]
type=identify
endpoint=free-pro-endpoint
match=FREE_REGISTRAR_IP

; Téléphone employé : configurez ce compte SIP sur le combiné/DECT du restaurant.
[100]
type=endpoint
transport=transport-udp
context=restaurant-internal
disallow=all
allow=ulaw,alaw
auth=100-auth
aors=100-aor

[100-auth]
type=auth
auth_type=userpass
username=100
password=EMPLOYEE_PHONE_RANDOM_PASSWORD

[100-aor]
type=aor
max_contacts=1
remove_existing=yes
