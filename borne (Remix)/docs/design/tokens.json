{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "FoodKing Kiosk V1 design tokens — W3C DTCG format",
  "$version": "1.0.0",

  "color": {
    "$description": "Palette FoodKing. Tous les tokens contrast-safe AA par défaut ; les tokens *-aaa sont des overrides pour le mode contraste renforcé.",

    "brand": {
      "red":       { "$value": "#E8001C", "$type": "color", "$description": "Rouge FoodKing — primaire" },
      "red-dark":  { "$value": "#B8001A", "$type": "color" },
      "red-soft":  { "$value": "#FFE6E9", "$type": "color", "$description": "Fond tinté pour état actif" },
      "red-aaa":   { "$value": "#A00013", "$type": "color", "$description": "Rouge AAA sur fond blanc (ratio ≥ 7:1)" }
    },

    "neutral": {
      "bg":          { "$value": "#FFF9F5", "$type": "color", "$description": "Fond global warm" },
      "surface":     { "$value": "#FFFFFF", "$type": "color" },
      "surface-alt": { "$value": "#FFF2EA", "$type": "color", "$description": "Placeholder images, zones creuses" },
      "border":      { "$value": "#F0E4D8", "$type": "color" },
      "border-strong": { "$value": "#D9C9B8", "$type": "color" }
    },

    "text": {
      "primary":    { "$value": "#1A1A1A", "$type": "color", "$description": "Ratio 15.8:1 sur #FFF9F5 — AAA" },
      "soft":       { "$value": "#4A4540", "$type": "color", "$description": "Ratio 8.5:1 — AAA" },
      "mute":       { "$value": "#8A807A", "$type": "color", "$description": "Ratio 4.6:1 — AA seulement, interdit en AAA mode" },
      "on-red":     { "$value": "#FFFFFF", "$type": "color" },
      "primary-aaa":{ "$value": "#000000", "$type": "color" }
    },

    "semantic": {
      "success":    { "$value": "#16A34A", "$type": "color" },
      "warning":    { "$value": "#D97706", "$type": "color" },
      "error":      { "$value": "#DC2626", "$type": "color" },
      "info":       { "$value": "#2563EB", "$type": "color" },
      "success-aaa":{ "$value": "#0D7A33", "$type": "color" },
      "error-aaa":  { "$value": "#A81717", "$type": "color" }
    },

    "badge": {
      "vegetarian": { "$value": "#16A34A", "$type": "color" },
      "halal":      { "$value": "#0D7A33", "$type": "color" },
      "spicy":      { "$value": "#DC2626", "$type": "color" },
      "new":        { "$value": "#E8001C", "$type": "color" },
      "chef-pick":  { "$value": "#D97706", "$type": "color" }
    },

    "focus": {
      "ring":     { "$value": "#2563EB", "$type": "color", "$description": "Focus ring visible — WCAG 2.4.7" },
      "ring-aaa": { "$value": "#0B2AB8", "$type": "color" }
    },

    "overlay": {
      "modal":     { "$value": "rgba(26, 26, 26, 0.55)", "$type": "color" },
      "rupture":   { "$value": "rgba(255, 255, 255, 0.92)", "$type": "color" }
    }
  },

  "typography": {
    "$description": "Inter pour latin, Noto Sans Arabic pour ar. Tailles pensées pour 1080×1920 portrait.",

    "font-family": {
      "latin":  { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily" },
      "arabic": { "$value": "'Noto Sans Arabic', 'Inter', sans-serif", "$type": "fontFamily" },
      "mono":   { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily" }
    },

    "font-weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "black":    { "$value": 900, "$type": "fontWeight" }
    },

    "font-size": {
      "$description": "Jamais < 20 px en mode normal. Mode malvoyant multiplie par 1.3.",
      "hero":      { "$value": "64px", "$type": "dimension" },
      "display":   { "$value": "48px", "$type": "dimension" },
      "title-lg":  { "$value": "36px", "$type": "dimension" },
      "title":     { "$value": "28px", "$type": "dimension" },
      "subtitle":  { "$value": "22px", "$type": "dimension" },
      "body":      { "$value": "20px", "$type": "dimension" },
      "caption":   { "$value": "18px", "$type": "dimension" },
      "micro":     { "$value": "16px", "$type": "dimension", "$description": "Badges uniquement, jamais pour du texte lisible" }
    },

    "line-height": {
      "tight":  { "$value": 1.15, "$type": "number" },
      "snug":   { "$value": 1.3, "$type": "number" },
      "normal": { "$value": 1.5, "$type": "number" }
    },

    "letter-spacing": {
      "tight":   { "$value": "-0.01em", "$type": "dimension" },
      "normal":  { "$value": "0", "$type": "dimension" },
      "wide":    { "$value": "0.05em", "$type": "dimension" },
      "widest":  { "$value": "0.12em", "$type": "dimension", "$description": "Pour caps de labels" }
    }
  },

  "spacing": {
    "$description": "Échelle 4 px. Les valeurs >= 48 respectent la cible tactile minimale.",

    "0":   { "$value": "0",    "$type": "dimension" },
    "1":   { "$value": "4px",  "$type": "dimension" },
    "2":   { "$value": "8px",  "$type": "dimension" },
    "3":   { "$value": "12px", "$type": "dimension" },
    "4":   { "$value": "16px", "$type": "dimension" },
    "5":   { "$value": "20px", "$type": "dimension" },
    "6":   { "$value": "24px", "$type": "dimension" },
    "8":   { "$value": "32px", "$type": "dimension" },
    "10":  { "$value": "40px", "$type": "dimension" },
    "12":  { "$value": "48px", "$type": "dimension", "$description": "Cible tactile minimale WCAG" },
    "14":  { "$value": "56px", "$type": "dimension" },
    "16":  { "$value": "64px", "$type": "dimension" },
    "20":  { "$value": "80px", "$type": "dimension" },
    "24":  { "$value": "96px", "$type": "dimension" },
    "32":  { "$value": "128px","$type": "dimension" }
  },

  "radius": {
    "none":  { "$value": "0",    "$type": "dimension" },
    "sm":    { "$value": "8px",  "$type": "dimension" },
    "md":    { "$value": "16px", "$type": "dimension" },
    "lg":    { "$value": "24px", "$type": "dimension" },
    "xl":    { "$value": "28px", "$type": "dimension", "$description": "ProductCard" },
    "2xl":   { "$value": "32px", "$type": "dimension" },
    "pill":  { "$value": "999px","$type": "dimension" }
  },

  "shadow": {
    "card":     { "$value": "0 4px 14px rgba(232, 0, 28, 0.08)", "$type": "shadow" },
    "card-hover": { "$value": "0 8px 24px rgba(232, 0, 28, 0.12)", "$type": "shadow" },
    "modal":    { "$value": "0 24px 48px rgba(26, 26, 26, 0.24)", "$type": "shadow" },
    "sticky-footer": { "$value": "0 -8px 24px rgba(0, 0, 0, 0.06)", "$type": "shadow" }
  },

  "motion": {
    "$description": "Durées et easings pour animations. En mode reduced-motion ou low-perf : duration = 0.",

    "duration": {
      "instant": { "$value": "0ms",   "$type": "duration" },
      "fast":    { "$value": "140ms", "$type": "duration", "$description": "Tap feedback" },
      "base":    { "$value": "240ms", "$type": "duration", "$description": "Step transitions, modals" },
      "slow":    { "$value": "360ms", "$type": "duration", "$description": "Category swap, slide large" },
      "idle":    { "$value": "800ms", "$type": "duration", "$description": "Idle breathing pulse" }
    },

    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",   "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0.2, 1)",   "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)",   "$type": "cubicBezier" },
      "bounce":   { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    }
  },

  "layout": {
    "$description": "Contraintes layout spécifiques kiosk portrait 1080×1920.",

    "screen": {
      "width":  { "$value": "1080px", "$type": "dimension" },
      "height": { "$value": "1920px", "$type": "dimension" }
    },

    "pmr-zone": {
      "top":    { "$value": "160px",  "$type": "dimension", "$description": "Limite haute zone PMR" },
      "bottom": { "$value": "1760px", "$type": "dimension", "$description": "Limite basse zone PMR" },
      "height": { "$value": "1600px", "$type": "dimension" }
    },

    "touch-target": {
      "min":        { "$value": "48px", "$type": "dimension", "$description": "WCAG 2.2 AA" },
      "comfortable":{ "$value": "64px", "$type": "dimension" },
      "large":      { "$value": "80px", "$type": "dimension" }
    },

    "safe-area": {
      "top":    { "$value": "32px", "$type": "dimension" },
      "bottom": { "$value": "32px", "$type": "dimension" },
      "left":   { "$value": "32px", "$type": "dimension" },
      "right":  { "$value": "32px", "$type": "dimension" }
    }
  },

  "z-index": {
    "base":    { "$value": 0,    "$type": "number" },
    "sticky":  { "$value": 10,   "$type": "number" },
    "overlay": { "$value": 100,  "$type": "number" },
    "modal":   { "$value": 200,  "$type": "number" },
    "toast":   { "$value": 300,  "$type": "number" },
    "keyboard":{ "$value": 400,  "$type": "number", "$description": "Clavier virtuel toujours devant" }
  },

  "a11y": {
    "$description": "Paramètres a11y exposés au runtime.",

    "focus-ring-width": { "$value": "4px", "$type": "dimension" },
    "focus-ring-offset": { "$value": "2px", "$type": "dimension" },

    "contrast-ratio": {
      "aa-normal":  { "$value": 4.5, "$type": "number" },
      "aa-large":   { "$value": 3,   "$type": "number" },
      "aaa-normal": { "$value": 7,   "$type": "number" },
      "aaa-large":  { "$value": 4.5, "$type": "number" }
    },

    "text-scale": {
      "normal":       { "$value": 1,   "$type": "number" },
      "high-contrast":{ "$value": 1.3, "$type": "number" }
    },

    "idle-timeout-s": {
      "normal":             { "$value": 180, "$type": "number" },
      "high-contrast":      { "$value": 240, "$type": "number" },
      "pmr":                { "$value": 300, "$type": "number" },
      "pmr-high-contrast":  { "$value": 360, "$type": "number" }
    },

    "countdown-s": {
      "normal":             { "$value": 10, "$type": "number" },
      "high-contrast":      { "$value": 15, "$type": "number" },
      "pmr":                { "$value": 20, "$type": "number" },
      "pmr-high-contrast":  { "$value": 25, "$type": "number" }
    },

    "auto-advance-ms": {
      "normal":        { "$value": 350, "$type": "number" },
      "high-contrast": { "$value": 500, "$type": "number" },
      "pmr":           { "$value": 600, "$type": "number" }
    },

    "undo-lockout-ms": {
      "normal":        { "$value": 2000, "$type": "number" },
      "high-contrast": { "$value": 3000, "$type": "number" },
      "pmr":           { "$value": 3500, "$type": "number" }
    }
  }
}
