# === FoodKing — .cursorignore ===
# Empêche Cursor d'indexer les fichiers lourds, générés ou non pertinents.

# Dépendances
node_modules/
vendor/

# Build / assets compilés
public/js/app.js
public/css/app.css
public/mix-manifest.json
public/hot

# Cache Laravel
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
bootstrap/cache/

# Environnement et secrets
.env
.env.backup
.env.production

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
.DS_Store

# Divers générés
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
