# Copier vers .env.orcai (gitignored) — NE JAMAIS COMMITTER.
# Clés exposées dans un chat / ticket : régénérer immédiatement côté fournisseur.

ANTHROPIC_BASE_URL=https://api.orcai.cc
ANTHROPIC_AUTH_TOKEN=REPLACE_ME
# Optionnel OpenCode / SDK:
ORCAI_API_KEY=REPLACE_ME

# Super-audit scripts/run-super-audit-orcai.py (optionnel)
# ORCAI_SUPER_AUDIT_MAX_TOKENS=0
# ORCAI_SUPER_AUDIT_MAX_TOKENS_CAP=262144
# ORCAI_SUPER_AUDIT_MIN_TOTAL_TOKENS=100000
# ORCAI_SUPER_AUDIT_MAX_PASSES=24
# ORCAI_OUTPUT_EFFORT=max
#
# Audit via API /v1/messages (sans CLI `claude`, utile si quota terminal) :
#   node scripts/run-messages-api-audit.mjs reports/audit/_TON_PROMPT.txt reports/audit/SORTIE.md
#   (mêmes ANTHROPIC_* ; option AUDIT_API_MAX_TOKENS, AUDIT_API_OUTPUT_EFFORT=max)
