[Unit]
Description=FoodKing Laravel Scheduler (one-shot, called every minute by foodking-scheduler.timer)
Documentation=https://laravel.com/docs/scheduling
After=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__REPO_DIR__
ExecStart=__PHP_BIN__ __REPO_DIR__/artisan schedule:run
StandardOutput=journal
StandardError=journal
SyslogIdentifier=foodking-scheduler

# --- Security hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__REPO_DIR__/storage __REPO_DIR__/bootstrap/cache
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
