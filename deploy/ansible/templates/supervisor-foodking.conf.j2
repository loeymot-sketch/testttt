; Generated by Ansible — do not edit manually.
; FoodKing V1 Supervisor — queue worker + Soketi WS server.
; VPS-1 sizing (group_vars/all.yml comment): 2 vCPU, 4 GB RAM.
; Queue work is largely I/O-bound (Redis + MySQL + Soketi pub), so numprocs=2
; remains defensible on 2 vCPU. Bring to numprocs=1 if VPS CPU saturates.

[program:foodking-queue]
process_name=%(program_name)s_%(process_num)02d
command=php{{ php_version }} {{ app_root }}/artisan queue:work redis --queue=high,default --tries=3 --timeout=120 --max-jobs=1000 --sleep=3
autostart=true
autorestart=true
user=www-data
numprocs=2
redirect_stderr=true
stdout_logfile=/var/log/supervisor/foodking-queue.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=60
stopsignal=QUIT

[program:foodking-soketi]
; Soketi config file must be provisioned by owner (group_vars/vault.yml)
; BEFORE first supervisor reload. Path is intentionally inside {{ app_root }}
; so it follows app deploy lifecycle. If missing, soketi will fail on start
; and supervisor will leave the program in FATAL state (visible via
; `supervisorctl status foodking-soketi`).
command=/usr/local/bin/soketi start --config={{ app_root }}/soketi.json
autostart=true
autorestart=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/log/supervisor/foodking-soketi.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=10

; --- foodking-scheduler (DISABLED, owner opt-in) -----------------------------
; The Ansible site.yml installs a system crontab line for `php artisan
; schedule:run` (see `Cron — Laravel schedule:run every minute`). If owner
; prefers supervisor-managed scheduling (e.g. to remove cron dependency),
; uncomment the block below AND remove the `Cron — Laravel schedule:run`
; task from site.yml — running both = double-fire every minute.
;
; [program:foodking-scheduler]
; command=/bin/sh -c "while true; do php{{ php_version }} {{ app_root }}/artisan schedule:run >/dev/null 2>&1; sleep 60; done"
; autostart=true
; autorestart=true
; user=www-data
; numprocs=1
; redirect_stderr=true
; stdout_logfile=/var/log/supervisor/foodking-scheduler.log
