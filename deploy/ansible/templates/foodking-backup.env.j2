# {{ ansible_managed }}
# [V1 Cloud-Prep insights P1-#10 2026-05-18] Backup script env file.
# Consumed by scripts/backup-foodking-daily.sh via the cron-line
# `. /etc/foodking-backup.env && ...` (see site.yml `Cron — daily backup`).
#
# Mode 0640 + owner root:root — secrets readable only by root + www-data
# group (cron job runs as www-data and must be able to source this file).
#
# DO NOT edit this file by hand on the production host: it is overwritten
# every Ansible run. Edit the source template + group_vars/all.yml / vault.yml.

# --- App root (consumed by backup script `set -a; . $APP_ROOT/.env`) ---------
FOODKING_ROOT={{ app_root }}

# --- OVH Object Storage (S3-compatible) — NF525 6y retention bucket ---------
BACKUP_S3_BUCKET={{ backup_s3_bucket }}
BACKUP_LOCAL_DIR={{ backup_local_dir | default('/var/backups/foodking') }}
BACKUP_LOCAL_RETENTION_DAYS={{ backup_local_retention_days | default(7) }}

# --- Alert webhook fired on backup failure (Slack/Discord/PagerDuty) --------
# Empty string disables alerting (the backup script no-ops the curl POST).
BACKUP_ALERT_WEBHOOK={{ backup_alert_webhook | default('') }}
