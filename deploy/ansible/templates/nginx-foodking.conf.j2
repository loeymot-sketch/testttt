# Generated by Ansible — do not edit manually.
# FoodKing V1 Nginx vhost. HTTP-only on first apply; certbot --nginx (site.yml
# `Let's Encrypt cert` task) injects the 443 server block, redirect 80->443,
# and HSTS header in-place. This template stays ACME-friendly so `nginx -t`
# succeeds BEFORE Certbot ever runs (otherwise the playbook breaks at the
# `reload nginx` handler invoked by this template task).

# --- Rate limit zone (shared, declared once) ---------------------------------
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/s;

server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }} www.{{ nginx_server_name }};

    root {{ app_root }}/public;
    index index.php index.html;

    # Certbot ACME challenge (HTTP-01) — must remain reachable on port 80
    # even after TLS is provisioned (renewal). Certbot writes here.
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/html;
    }

    # Security headers (HSTS injected by certbot --nginx after TLS).
    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;  # Certbot injects after TLS

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    client_max_body_size 32M;

    # Laravel front-controller
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Rate-limit /api/* (60 r/s per IP, burst 30 nodelay)
    location ^~ /api/ {
        limit_req zone=api burst=30 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Soketi WebSocket auth (Laravel-side private channel signer)
    location = /broadcasting/auth {
        proxy_pass http://127.0.0.1:6001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Long-cache Mix-versioned static assets (?id=hash invalidates)
    location ~* ^/(js|css)/.*\.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Other static media — moderate cache
    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # PHP-FPM
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_read_timeout 120;
    }

    # Deny dotfiles + sensitive Laravel paths
    location ~ /\.(?!well-known).* { deny all; }
    location ~ ^/(storage/logs|\.env|composer\.(json|lock)) { deny all; }
}
