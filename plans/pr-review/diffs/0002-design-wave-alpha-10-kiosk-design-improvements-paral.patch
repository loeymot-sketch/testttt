+}
+
+/* Shimmer animation (respect prefers-reduced-motion) */
+@keyframes kiosk-skeleton-shimmer {
+    0% { background-position: -200px 0; }
+    100% { background-position: calc(200px + 100%) 0; }
+}
+
+.kiosk-skeleton-shape {
+    background: linear-gradient(
