+.poc-debug-title {
+    font-size: 14px;
+    font-weight: 700;
+    color: var(--kiosk-text-muted, #5A5A5A);
+    margin: 0 0 8px;
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+}
