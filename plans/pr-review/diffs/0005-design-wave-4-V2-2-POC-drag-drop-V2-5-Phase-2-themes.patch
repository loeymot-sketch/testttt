+                            }
+                        })
+                        .catch(() => {});
+                } else if (
+                    this.selectedBranchId === null &&
+                    this.branches.length > 0
+                ) {
+                    this.selectedBranchId = this.branches[0].id;
+                }
+            } catch (e) {
+                // non-fatal
+            }
+        },
+        addLine() {
+            this.cartItems.push({ item_id: null, quantity: 1 });
+        },
+        removeLine(idx) {
+            if (this.cartItems.length > 1) {
