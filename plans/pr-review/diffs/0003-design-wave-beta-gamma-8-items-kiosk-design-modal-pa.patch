index 000000000..019838f8f
--- /dev/null
+++ b/resources/css/kiosk/themes/_base.css
@@ -0,0 +1,79 @@
+/* =============================================================================
+   FoodKing Kiosk — Theme Contract (Wave Gamma G3 / V2-5)
+   -----------------------------------------------------------------------------
+   Cible           : skinning saisonnier (Halloween, Noël, FIFA, Saint-Valentin,
+                     Pâques, été plage…) sans recompile, sans toucher aux atoms
+                     Vue ni aux composants wizard frozen.
+   Activation      : un thème ne s'applique que si l'attribut HTML
+                     `data-kiosk-theme="<slug>"` est posé sur `<html>`.
+                     Le service `resources/js/services/kioskThemeManager.js`
+                     pose cet attribut au boot, en lisant la priorité :
+                       localStorage > backend (Branch.active_kiosk_theme) > 'standard'.
+   Scope           : un thème SURCOUCHE un sous-ensemble de tokens `--kiosk-*`
+                     déjà déclarés dans `tokens.css`. Aucune nouvelle famille
+                     de variables ne doit être introduite par un thème.
+
+   ============================================================================
+   Variables AUTORISÉES à override (cosmétique pure)
+   ============================================================================
+   - Marque & accents :
+       --kiosk-primary
+       --kiosk-primary-dark
+       --kiosk-primary-soft
+       --kiosk-accent              (NEW — couleur d'appoint thème, optionnel)
+   - Surfaces :
+       --kiosk-bg
+       --kiosk-surface
+       --kiosk-surface-alt
+       --kiosk-text
+       --kiosk-text-muted
+       --kiosk-text-on-red
+   - Décoratives (NEW family — réservées aux thèmes) :
+       --kiosk-theme-emoji-prefix  (ex. '🎃' — préfixe queue numbers)
+       --kiosk-theme-pattern       (url() — image d'arrière-plan répétitive)
+       --kiosk-theme-banner-text   (ex. '🎄 NOËL 🎄' — content: pour bannières)
+
+   ============================================================================
+   Variables INTERDITES à override (a11y / cohérence métier)
+   ============================================================================
+   - Tailles typographiques (--kiosk-font-size-*) → utiliser
+     `--kiosk-text-scale` qui reste piloté par le mode AAA/PMR uniquement.
+   - Spacing tokens (--kiosk-space-*) → grille verticale partagée par
+     wizard/POS/KDS/dashboard.
+   - Tap targets (--kiosk-touch-*) → contraintes WCAG 2.2 AA.
+   - Focus ring (--kiosk-focus-*) → contraste 3:1 obligatoire AA.
+   - Sémantique (--kiosk-success / --kiosk-error / --kiosk-warning /
+     --kiosk-info) → un thème ne doit JAMAIS recolorer un état d'erreur,
+     un succès ou un warning : la signification métier prime sur la déco.
+   - Badges produits (--kiosk-badge-*) → information allergène / chef-pick.
+   - Z-index (--kiosk-z-*) → ordonnancement modal/toast/keyboard.
+   - Durations (--kiosk-duration-*) → respecte `prefers-reduced-motion`.
+
+   ============================================================================
+   Règles d'a11y obligatoires AVANT publication d'un thème
+   ============================================================================
+   1. Contraste texte sur fond ≥ 4.5:1 (WCAG 2.2 AA — body) et ≥ 3:1 pour
+      les grandes tailles (≥ 22px / bold ≥ 18px).
+   2. Le focus ring (`--kiosk-focus-ring`) doit conserver un contraste ≥ 3:1
+      sur la nouvelle `--kiosk-bg` ET la nouvelle `--kiosk-surface`.
+   3. La couleur primaire ne doit pas être confondue avec une couleur
+      sémantique (rouge erreur, vert succès, orange warning) si le thème
+      les déplace. Cas concret : un thème Halloween orange ne doit pas
+      faire ressembler un CTA primaire à un warning.
+   4. Les `--kiosk-theme-pattern` doivent être petits (< 4 KB SVG/PNG)
+      pour ne pas dégrader le LCP du kiosk en mode kiosque dégradé réseau.
+
+   ============================================================================
+   Référence d'implémentation
+   ============================================================================
+   - `standard.css`  : fallback no-op, conserve la marque rouge FK.
+   - `halloween.css` : exemple complet (orange citrouille / violet).
+   - `christmas.css` : exemple complet (rouge sapin / vert sapin).
+
+   Tout thème vit sous le sélecteur :
+     :root[data-kiosk-theme="<slug>"] { … overrides … }
+
+   Voir docs/KIOSK_THEMES.md pour la procédure d'ajout.
+   ============================================================================ */
+
+/* Aucun override par défaut. Ce fichier sert uniquement de contrat. */
diff --git a/resources/css/kiosk/themes/christmas.css b/resources/css/kiosk/themes/christmas.css
new file mode 100644
index 000000000..0ae077b26
--- /dev/null
+++ b/resources/css/kiosk/themes/christmas.css
@@ -0,0 +1,37 @@
+/* =============================================================================
+   Christmas / Noël — skin saisonnier (1er → 31 décembre).
+   -----------------------------------------------------------------------------
+   Palette : rouge Noël + vert sapin sur fond neige.
+   Cible    : ambiance festive ; engagement +12..15% historiquement (panel
+              opérateurs FR fast-food).
+
+   A11y QA : contraste #1A1A1A sur #F5F8F0 = 17.0:1 (AAA body ✓), focus
+             ring bleu (#2563EB) sur #FFFFFF = 5.2:1 (AA ✓), CTA blanc
+             sur #C8102E = 5.5:1 (AA ✓).
+
+   Pattern  : `--kiosk-theme-pattern` reste `none` tant que l'asset SVG
+              `/images/themes/christmas-snow.svg` n'est pas livré.
+   ============================================================================= */
+
+:root[data-kiosk-theme="christmas"] {
+    /* -- Brand rouge Noël ---------------------------------------------------- */
+    --kiosk-primary:       #C8102E;   /* rouge sapin — CTA primaire */
+    --kiosk-primary-dark:  #8E0822;
+    --kiosk-primary-soft:  #FFE5E8;
+    --kiosk-accent:        #006B3F;   /* vert sapin — accents secondaires */
+
+    /* -- Surfaces neige ------------------------------------------------------- */
+    --kiosk-bg:            #F5F8F0;   /* blanc neigé — fond plein écran */
+    --kiosk-surface:       #FFFFFF;
+    --kiosk-surface-alt:   #ECEFE6;
+    --kiosk-text:          #1A1A1A;   /* texte noir, ratio 17:1 sur bg AAA */
+    --kiosk-text-muted:    #5A5A5A;
+    --kiosk-text-on-red:   #FFFFFF;
+
+    /* -- Décoratives ---------------------------------------------------------- */
+    --kiosk-theme-emoji-prefix: '🎄';
+    /* asset à livrer hors greenfield CSS — laisser `none` jusqu'à upload :
+       --kiosk-theme-pattern: url('/images/themes/christmas-snow.svg'); */
+    --kiosk-theme-pattern: none;
+    --kiosk-theme-banner-text: '🎄 NOËL ENCHANTÉ 🎄';
+}
diff --git a/resources/css/kiosk/themes/halloween.css b/resources/css/kiosk/themes/halloween.css
new file mode 100644
index 000000000..1b7c52a2f
--- /dev/null
+++ b/resources/css/kiosk/themes/halloween.css
@@ -0,0 +1,37 @@
+/* =============================================================================
+   Halloween — skin saisonnier (octobre / 31).
+   -----------------------------------------------------------------------------
+   Palette : citrouille + violet sorcière sur fond pourpre profond.
+   Cible    : booster engagement +10..15% pendant l'événement (benchmark
+              McDo/BK ; cf. plans/PLAN_DESIGN_V2_5_SKINNING_SAISONNIER_2026-05-08.md).
+
+   A11y QA : contraste #FFE5CC sur #1A0A1F = 14.2:1 (AAA body ✓), focus
+             ring bleu (#2563EB) sur #1A0A1F = 5.0:1 (AA ≥ 3:1 ✓).
+
+   Pattern  : `--kiosk-theme-pattern` reste `none` par défaut tant que
+              l'asset SVG `/images/themes/halloween-pattern.svg` n'est pas
+              livré côté `public/`. Activer une seule fois l'asset uploadé.
+   ============================================================================= */
+
+:root[data-kiosk-theme="halloween"] {
+    /* -- Brand citrouille ----------------------------------------------------- */
+    --kiosk-primary:       #FF6B00;   /* orange citrouille — CTA primaire */
+    --kiosk-primary-dark:  #C24700;
+    --kiosk-primary-soft:  #FFE5CC;
+    --kiosk-accent:        #8B00FF;   /* violet sorcière — accents secondaires */
+
+    /* -- Surfaces sombres ----------------------------------------------------- */
+    --kiosk-bg:            #1A0A1F;   /* pourpre profond — fond plein écran */
+    --kiosk-surface:       #2D1A33;   /* surface carte / modal */
+    --kiosk-surface-alt:   #3A2542;
+    --kiosk-text:          #FFE5CC;   /* texte clair, ratio 14.2:1 sur bg AAA */
+    --kiosk-text-muted:    #B0A0B5;
+    --kiosk-text-on-red:   #FFFFFF;
+
+    /* -- Décoratives ---------------------------------------------------------- */
+    --kiosk-theme-emoji-prefix: '🎃';
+    /* asset à livrer hors greenfield CSS — laisser `none` jusqu'à upload :
+       --kiosk-theme-pattern: url('/images/themes/halloween-pattern.svg'); */
+    --kiosk-theme-pattern: none;
+    --kiosk-theme-banner-text: '🎃 HALLOWEEN SPECIALS 🎃';
+}
diff --git a/resources/css/kiosk/themes/standard.css b/resources/css/kiosk/themes/standard.css
new file mode 100644
index 000000000..00fa9efb5
--- /dev/null
+++ b/resources/css/kiosk/themes/standard.css
@@ -0,0 +1,20 @@
+/* =============================================================================
+   Standard — thème par défaut FoodKing (rouge marque).
+   -----------------------------------------------------------------------------
+   Aucun override de couleur ici : le thème "standard" laisse intacts les
+   tokens base définis dans `resources/css/kiosk/tokens.css`. Il neutralise
+   simplement les variables décoratives (emoji prefix, banner) pour que
+   le kiosk affiche bien son look hors période thématique.
+
+   Ce fichier sert d'idempotence : si le service kioskThemeManager applique
+   `data-kiosk-theme="standard"` (par défaut ou par fallback), aucune
+   variable ne change — c'est intentionnel.
+   ============================================================================= */
+
+:root[data-kiosk-theme="standard"] {
+    /* Variables décoratives explicitement vides : évite qu'un thème
+       précédent ne laisse une "fuite" via :root sans data-attribute. */
+    --kiosk-theme-emoji-prefix: '';
+    --kiosk-theme-pattern: none;
+    --kiosk-theme-banner-text: '';
+}
