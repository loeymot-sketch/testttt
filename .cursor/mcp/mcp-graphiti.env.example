MOONSHOT_API_BASE=https://api.moonshot.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:4000
GRAPHITI_GROUP_ID=foodking
OPENAI_API_URL=
OPENAI_EMBEDDING_API_URL=http://127.0.0.1:4000/v1
GRAPHITI_LLM_MODEL=
