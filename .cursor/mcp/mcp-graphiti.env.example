# Copie ce fichier vers ~/.cursor/mcp-graphiti.env puis remplis les valeurs.
# chmod 600 ~/.cursor/mcp-graphiti.env
#
# Utilisé par start-graphiti-mcp.sh (plus de secrets dans ~/.cursor/mcp.json).

# Clone local du serveur Graphiti (Zep). Défaut dans start-graphiti-mcp.sh : ${HOME}/graphiti
# GRAPHITI_DIR=/chemin/absolu/vers/graphiti

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
