{
  "mcpServers": {
    "graphiti": {
      "command": "bash",
      "args": [
        "/ABSOLUTE/PATH/TO/foodking-web/web/testttt/.cursor/mcp/start-graphiti-mcp.sh"
      ],
      "env": {
        "NEO4J_URI": "neo4j+s://YOUR_INSTANCE.databases.neo4j.io",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "YOUR_NEO4J_PASSWORD",
        "NEO4J_DATABASE": "neo4j",
        "MOONSHOT_API_KEY": "YOUR_MOONSHOT_API_KEY",
        "MOONSHOT_API_BASE": "https://api.moonshot.ai/v1",
        "OPENAI_API_KEY": "litellm-proxy",
        "OPENAI_BASE_URL": "http://127.0.0.1:4000",
        "OPENAI_API_URL": "http://127.0.0.1:4000/v1",
        "OPENAI_EMBEDDING_API_KEY": "YOUR_OPENAI_EMBEDDING_PROJECT_KEY",
        "OPENAI_EMBEDDING_API_URL": "http://127.0.0.1:4000/v1",
        "GRAPHITI_GROUP_ID": "foodking"
      }
    }
  }
}
