<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# [SEC-30-1] Security headers — prevent clickjacking, MIME sniffing, XSS
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# [GOAL-HEAL-SEC-001 2026-05-23] Defense-in-depth — deny direct access to
# credential bundle file extensions anywhere under public/ (recursive,
# applies to public/file/, public/storage/ symlink target, future subdirs).
# The Firebase Admin service-account JSON has been relocated to
# storage/app/firebase/ (non-public) and pinned via the firebase_private
# disk on NotificationSetting's media collection — this rule is a belt-
# and-braces guard against future regressions or operator mistakes.
# Phase B.3 Security RED-team finding B3.2-001.
<FilesMatch "\.(pem|key|p12|pkcs12|crt|cer|ppk|asc|gpg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
# NOTE: *.json is denied ONLY under public/file/ (see public/file/.htaccess)
# because public/storage/ legitimately serves JSON-shaped media metadata
# from non-credential Spatie collections. Credential-bearing JSON would
# represent a regression and is caught by the sentinel
# tests/Feature/Security/FirebaseKeyStorageSecurityTest.php.

# [Audit 2026-05-29 PERF-015] Far-future caching for versioned static assets.
# Laravel Mix uses .version() — every content change produces a new URL hash,
# so we can safely cache aggressively without staleness risk on app updates.
# Owner audit estimate: ~500ms saved per cold reload (kiosk + POS).
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS/JS/fonts — far-future (Mix .version() URL-hash busts on change)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Images — 1 month (manual catalog refresh cycle, owner curates)
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"

    # HTML/JSON — NO cache (Laravel routing + API responses dynamic per request)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cache-Control header for versioned static assets (1 month default).
    # Overridden granularly above by ExpiresByType for specific MIME types.
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
