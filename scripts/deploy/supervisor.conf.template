; =============================================================================
; FoodKing Le Cayenne — Supervisor program templates
; -----------------------------------------------------------------------------
; Agent D.2 — Phase D — Owner D7=prepare-now
;
; DEPLOYMENT
;   1. cp scripts/deploy/supervisor.conf.template /etc/supervisor/conf.d/lecayenne.conf
;   2. Substitute placeholders below (LECAYENNE_*) with real values.
;   3. supervisorctl reread
;   4. supervisorctl update
;   5. supervisorctl status   (should show lecayenne-queue-worker_00, _01, lecayenne-soketi)
;
; PLACEHOLDERS
;   __LECAYENNE_ROOT__       — e.g. /var/www/lecayenne
;   __PHP_BIN__              — e.g. /usr/bin/php (or /usr/bin/php8.4)
;   __APP_USER__             — e.g. www-data
;
; PROGRAMS
;   - lecayenne-queue-worker  — 2 instances of `queue:work redis` for outbox
;                               pattern (high lane → KDS/OSS realtime).
;                               2 instances is the V1 Le Cayenne LOCAL single-box
;                               sizing; raise numprocs for higher throughput.
;   - lecayenne-soketi        — WebSocket server bound to 127.0.0.1:6001,
;                               reverse-proxied by nginx /app/ + /apps/.
;
; NF525 / ARCHITECTURE NOTES
;   - The `high` queue is the outbox lane (DispatchDomainEventsJob → Pusher).
;     Without the worker running, KDS/OSS only refresh through 30s polling
;     fallback — silent SLA breach. /api/health/ready returns 503 if more than
;     10 domain_events rows are stale (worker DOWN tell).
;   - tries=3 + timeout=120 mirrors production-validated defaults. backoff
;     ladder is configured per-job via Job::backoff() in the codebase.
;   - max-jobs=1000 forces the worker to graceful-restart, freeing leaked
;     memory (e.g. broadcast payload buffers).
; =============================================================================

; -----------------------------------------------------------------------------
; Queue worker — 2 instances on the high+default lanes.
; -----------------------------------------------------------------------------
[program:lecayenne-queue-worker]
process_name=%(program_name)s_%(process_num)02d
command=__PHP_BIN__ __LECAYENNE_ROOT__/artisan queue:work redis --queue=high,default --tries=3 --timeout=120 --max-jobs=1000 --sleep=1 --no-interaction
directory=__LECAYENNE_ROOT__
user=__APP_USER__
numprocs=2
autostart=true
autorestart=true
startsecs=3
stopwaitsecs=130                ; > timeout=120 so SIGTERM lets the current job finish
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/lecayenne-queue-worker.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=10
environment=LARAVEL_ENV="production"

; -----------------------------------------------------------------------------
; Soketi WebSocket server (Pusher-compatible self-hosted broadcaster).
; -----------------------------------------------------------------------------
; The .bin/soketi shim is a node entry script — invoking it directly is fine;
; no need to prefix with `node`. Owner edits soketi.json with the same app
; key/secret/id that the Laravel .env carries (PUSHER_APP_*).
; -----------------------------------------------------------------------------
[program:lecayenne-soketi]
command=__LECAYENNE_ROOT__/node_modules/.bin/soketi start --config=__LECAYENNE_ROOT__/soketi.json
directory=__LECAYENNE_ROOT__
user=__APP_USER__
autostart=true
autorestart=true
startsecs=3
stopwaitsecs=10
redirect_stderr=true
stdout_logfile=/var/log/supervisor/lecayenne-soketi.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=10
environment=NODE_ENV="production"

; -----------------------------------------------------------------------------
; Optional group — restart all lecayenne services in one command:
;   supervisorctl restart lecayenne:*
; -----------------------------------------------------------------------------
[group:lecayenne]
programs=lecayenne-queue-worker,lecayenne-soketi
priority=999
